generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                   String       @id @default(uuid())
  email                String       @unique
  passwordHash         String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  profile              UserProfile?
}

model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  mdaId     String?
  fullName  String
  role      Role     @default(MDA_OFFICER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mda       MDA?     @relation(fields: [mdaId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mdaId], map: "UserProfile_mdaId_fkey")
}

model MDA {
  id        String        @id @default(uuid())
  name      String
  code      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  profiles  UserProfile[]
  projects  Project[]
}

model Project {
  projectId          String           @id @default(uuid()) @map("project_id")
  mdaId              String           @map("mda_id")
  title              String
  sector             String
  lga                String
  senatorialDistrict String           @map("senatorial_district")
  locationText       String           @map("location_text")
  startDate          DateTime         @map("start_date")
  endDate            DateTime         @map("end_date")
  approvedBudget     Decimal          @map("approved_budget") @db.Decimal(15, 2)
  fundingSource      String           @map("funding_source")
  contractor         String?
  status             String
  isArchived         Boolean          @default(false) @map("is_archived")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt
  financeRecords     FinanceRecord[]
  issues             Issue[]
  progressUpdates    ProgressUpdate[]
  mda                MDA              @relation(fields: [mdaId], references: [id])

  @@index([mdaId], map: "projects_mda_id_fkey")
  @@map("projects")
}

model ProgressUpdate {
  id                  String       @id @default(uuid())
  projectId           String       @map("project_id")
  reportDate          DateTime     @map("report_date")
  physicalProgressPct Float        @map("physical_progress_pct")
  stage               String
  milestoneStatus     String       @map("milestone_status")
  keyUpdate           String       @map("key_update") @db.Text
  issueFlag           String?      @map("issue_flag")
  evidenceLink        String?      @map("evidence_link")
  status              ReportStatus @default(DRAFT)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt
  issues              Issue[]
  project             Project      @relation(fields: [projectId], references: [projectId])

  @@index([projectId], map: "progress_updates_project_id_fkey")
  @@map("progress_updates")
}

model FinanceRecord {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  budgetYear     Int      @map("budget_year")
  releaseToDate  Decimal  @map("release_to_date") @db.Decimal(15, 2)
  paymentsToDate Decimal  @map("payments_to_date") @db.Decimal(15, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [projectId])

  @@index([projectId], map: "finance_project_id_fkey")
  @@map("finance")
}

model Issue {
  id               String          @id @default(uuid())
  projectId        String          @map("project_id")
  logDate          DateTime        @map("log_date")
  issueCategory    String          @map("issue_category")
  issueItem        String          @map("issue_item")
  severity         Int
  owner            String
  dueDate          DateTime        @map("due_date")
  status           String          @default("Open")
  notes            String          @db.Text
  followUp         String?         @map("follow_up") @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  progressUpdateId String?         @map("progress_update_id")
  progressUpdate   ProgressUpdate? @relation(fields: [progressUpdateId], references: [id], onDelete: Cascade)
  project          Project         @relation(fields: [projectId], references: [projectId])

  @@index([progressUpdateId], map: "issues_progress_update_id_fkey")
  @@index([projectId], map: "issues_project_id_fkey")
  @@map("issues")
}

enum Role {
  WEBMASTER_ADMIN
  PPIMU_ADMIN
  MDA_OFFICER
}

enum ReportStatus {
  DRAFT
  SUBMITTED
}
